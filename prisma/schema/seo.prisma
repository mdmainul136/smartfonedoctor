// -------------------------------------------------------------
// Plugin-Style Reusable SEO, OpenGraph & AI/LLM Metadata Engine
// Pluggable across Pages, Blog Posts, Services & Landing Pages
// -------------------------------------------------------------

model SeoMetadata {
  id                    String    @id @default(cuid())

  // 🎯 Core SERP & Keyword Optimization
  metaTitle             String?
  metaDescription       String?   @db.Text
  focusKeyword          String?
  keywords              String[]  @default([])
  secondaryKeywords     String[]  @default([])
  canonicalUrl          String?
  breadcrumbTitle       String?

  // 🤖 Search Engine Robots & Crawling Directives
  robotsIndex           Boolean   @default(true)  // index vs noindex
  robotsFollow          Boolean   @default(true)  // follow vs nofollow
  robotsNoArchive       Boolean   @default(false) // noarchive
  robotsNoSnippet       Boolean   @default(false) // nosnippet
  robotsMaxSnippet      Int?      @default(-1)    // max-snippet: -1 (unlimited)
  robotsMaxImagePreview String?   @default("large") // max-image-preview: large
  robotsMaxVideoPreview Int?      @default(-1)    // max-video-preview: -1

  // 🧠 AI Search, LLM Crawlers & Semantic Citations (Perplexity, ChatGPT, Gemini, Applebot)
  allowAiCrawlers       Boolean   @default(true)  // GPTBot, ClaudeBot, PerplexityBot, Google-Extended
  allowAiTraining       Boolean   @default(true)  // Allow content for AI model training/RAG
  aiSummary             String?   @db.Text        // Pre-indexed semantic summary optimized for LLM RAG context
  aiSnippetEnabled      Boolean   @default(true)  // Allow AI search overviews / citations

  // 📱 Social & OpenGraph Protocol (Facebook, LinkedIn, Discord)
  ogTitle               String?
  ogDescription         String?   @db.Text
  ogImage               String?
  ogType                String?   @default("website")
  ogLocale              String?   @default("en_US")
  ogSiteName            String?   @default("SmartFoneDoctor")

  // 🐦 Twitter / X Cards
  twitterCard           String?   @default("summary_large_image") // summary, summary_large_image
  twitterTitle          String?
  twitterDescription    String?   @db.Text
  twitterImage          String?
  twitterCreator        String?   @default("@smartfonedoctor")

  // 🔍 Structured Data (Schema.org / JSON-LD Rich Snippets)
  schemaType            String?   @default("LocalBusiness") // LocalBusiness, TechArticle, Service, Product, FAQPage, HowTo
  structuredData        Json?     // Custom Schema.org JSON-LD graph override
  
  // 📊 Live Audit & RankMath Scoring
  score                 Int?      @default(85)  // Live calculated SEO score (0-100)
  readabilityScore      Int?      @default(90)  // Flesch-Kincaid readability score (0-100)
  auditPassed           Int?      @default(12)  // Number of passing checks
  auditTotal            Int?      @default(15)  // Total checks evaluated
  auditLog              Json?     // Full checklist state breakdown [{ id, label, passed, warning, desc }]

  // 🗺️ XML Sitemap & Indexing Priority
  includeInSitemap      Boolean   @default(true)
  sitemapPriority       Decimal?  @default(0.7) @db.Decimal
  changeFrequency       String?   @default("weekly") // always, hourly, daily, weekly, monthly, yearly, never

  // 🔀 Smart 301/302 Redirect Engine
  redirectUrl           String?
  redirectCode          Int?      // 301 (Permanent) or 302 (Temporary)

  // 🔌 Pluggable 1-to-1 Polymorphic Relations
  pageId                String?   @unique
  page                  CmsPage?  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  postId                String?   @unique
  post                  BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([focusKeyword])
  @@index([robotsIndex])
  @@index([allowAiCrawlers])
  @@map("seo_metadata")
}

// -------------------------------------------------------------
// Global Site SEO Configuration (Search Console, Social, Defaults)
// -------------------------------------------------------------
model SiteSeoSettings {
  id                     String   @id @default("global_seo_settings")
  siteName               String   @default("SmartFoneDoctor")
  titleSeparator         String   @default("|")
  defaultMetaTitle       String   @default("SmartFoneDoctor | Fast & Reliable Phone & Electronics Repair in Philadelphia")
  defaultMetaDescription String   @default("Expert cell phone, iPhone, iPad, MacBook, computer, and gaming console repair in Philadelphia, PA. Fast 30-minute screen and battery replacement with warranty.") @db.Text
  defaultOgImage         String?  @default("/logo-png.jpg")

  // 🎨 Branding Assets (Logo, Favicon, Dark Logo, Apple Icon)
  logoUrl                String?  @default("/logo-png.jpg")
  logoDarkUrl            String?  @default("/logo-transparent.png")
  faviconUrl             String?  @default("/favicon.ico")
  appleTouchIcon         String?  @default("/logo-png.jpg")

  // 📞 Organization & Contact Details
  contactPhone           String?  @default("+1 (215) 598-2090")
  contactEmail           String?  @default("contact@smartfonedoctor.com")
  streetAddress          String?  @default("33 S 52nd St")
  cityStateZip           String?  @default("Philadelphia, PA 19139")
  businessHours          String?  @default("Mon–Sat: 10:00 AM – 7:30 PM | Sun: 11:00 AM – 5:00 PM")

  // 🌐 Social Media & Profiles
  facebookUrl            String?  @default("https://facebook.com/smartfonedoctor")
  instagramUrl           String?  @default("https://instagram.com/smartfonedoctor")
  youtubeUrl             String?
  linkedinUrl            String?
  gmbUrl                 String?  @default("https://share.google/gTlyWLewR88ToAdJQ")

  googleSiteVerification String?
  bingSiteVerification   String?
  pinterestVerification  String?
  facebookAppId          String?
  twitterHandle          String?  @default("@smartfonedoctor")
  enableSitemap          Boolean  @default(true)
  enableRobotsTxt        Boolean  @default(true)
  enableLlmsTxt          Boolean  @default(true)
  enableAiBots           Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  @@map("site_seo_settings")
}

// -------------------------------------------------------------
// 301 / 302 Redirection & Canonical URL Engine
// -------------------------------------------------------------
model UrlRedirect {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique
  targetUrl   String
  statusCode  Int      @default(301) // 301 (Permanent) or 302 (Temporary)
  hitCount    Int      @default(0)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sourceUrl])
  @@index([isActive])
  @@map("url_redirects")
}
