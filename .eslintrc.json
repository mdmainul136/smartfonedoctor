{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": ["src/puck/**/*.ts", "src/puck/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/*", "@/components/*", "@/app/*", "@/plugins/*", "next/*"],
                "message": "src/puck is a standalone product: get app features through setBuilderHost() in src/puck/host.tsx instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
